# 固定官方 registry：防止本地装包时用镜像源地址重新污染 lockfile。
registry=https://registry.npmjs.org
# npm 12 默认 allow-remote=none / allow-file=none：
# - lockfile 含 npmmirror remote tarball（why-is-node-running）
# - xlsx 为 dashboard/vendor 内置 tarball（file: 依赖）
# 两者都需要显式放行。注意：不要启用 replace-registry-host——它会把 file:
# 依赖的路径也改写成 registry 前缀，导致 npm ci 直接 ENOENT。
allow-remote=all
allow-file=all
